msgstr "Активний"

msgid "Automatic translation is manually paused."
msgstr "Автоматичний переклад поставлено на ручну паузу."

msgid "Automatic translation is paused because the configured monthly character limit was reached."
msgstr "Автоматичний переклад призупинено, оскільки досягнуто налаштованого місячного ліміту символів."

msgid "Automatic translation is temporarily paused."
msgstr "Автоматичний переклад тимчасово призупинено."

