msgstr "Інвентаризація даних"

msgid "Deep scan completed. It compares source hashes and uses heavier read-only database queries."
msgstr "Поглиблене сканування завершено. Воно порівнює хеші джерел і використовує ресурсомісткіші read-only запити до бази даних."

msgid "Detected version"
msgstr "Виявлена версія"

msgid "Diagnostic findings"
msgstr "Діагностичні висновки"

msgid "Diagnostic mode"
msgstr "Режим діагностики"

msgid "Diagnostics"
msgstr "Діагностика"

msgid "Download deep privacy-safe JSON report"
msgstr "Завантажити поглиблений privacy-safe JSON-звіт"

